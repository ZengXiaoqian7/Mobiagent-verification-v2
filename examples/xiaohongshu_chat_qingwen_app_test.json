{
  "schema_version": "app-test-case-v1",
  "test_case_id": "xiaohongshu-chat-qingwen-001",
  "app_under_test": {
    "name": "小红书",
    "package": "com.xingin.xhs_hos",
    "version": "runtime-confirmed"
  },
  "feature": "send_chat_message",
  "preconditions": [
    {
      "condition_id": "logged_in",
      "type": "TEXT_ABSENT",
      "value_candidates": ["请先登录", "登录后查看", "Log in"],
      "failure_class": "ENV_BLOCKED",
      "description": "测试账号已经登录"
    },
    {
      "condition_id": "network_available",
      "type": "TEXT_ABSENT",
      "value_candidates": ["网络异常", "无网络", "未连接", "重试"],
      "failure_class": "ENV_BLOCKED",
      "description": "小红书可以正常访问网络"
    }
  ],
  "test_data": {
    "message_text": "你好呀我是评测智能体"
  },
  "observation_policy": {
    "immediate": true,
    "delays_ms": [500, 1500, 3000],
    "max_wait_ms": 5000,
    "stop_when_stable": true
  },
  "steps": [
    {
      "step_id": "open_xiaohongshu",
      "instruction": "打开小红书",
      "action_type": "OPEN_APP",
      "timeout_seconds": 15,
      "max_retries": 0
    },
    {
      "step_id": "open_messages",
      "instruction": "进入消息页面",
      "action_type": "CLICK",
      "target": {
        "role": "button",
        "text_candidates": ["消息", "私信"]
      },
      "timeout_seconds": 15,
      "max_retries": 1
    },
    {
      "step_id": "open_qingwen_chat",
      "instruction": "进入青文的聊天页面",
      "action_type": "CLICK",
      "target": {
        "role": "conversation",
        "text_candidates": ["青文"]
      },
      "timeout_seconds": 20,
      "max_retries": 1
    },
    {
      "step_id": "input_chat_message",
      "instruction": "在当前聊天输入框中输入测试消息",
      "action_type": "INPUT",
      "target": {
        "role": "text_input",
        "text_candidates": ["输入消息", "说点什么", "发送消息"]
      },
      "value_ref": "message_text",
      "timeout_seconds": 15,
      "max_retries": 1
    },
    {
      "step_id": "send_chat_message",
      "instruction": "发送这条测试消息",
      "action_type": "CLICK",
      "target": {
        "role": "button",
        "text_candidates": ["发送"]
      },
      "timeout_seconds": 15,
      "max_retries": 1
    }
  ],
  "expected_results": [
    {
      "assertion_id": "sent_message_visible_in_chat",
      "type": "TEXT_VISIBLE",
      "expected_value_ref": "message_text",
      "surface": "conversation",
      "after_step": "send_chat_message",
      "historical_match_not_sufficient": true,
      "required": true
    }
  ],
  "verification_runner_policy": "IF_DIRECT_UNKNOWN",
  "verification_policy": {
    "max_steps": 5,
    "timeout_seconds": 30,
    "max_retries": 1
  },
  "risk_level": "MEDIUM",
  "metadata": {
    "stage": "real-commercial-chat-smoke",
    "manual_review_required": true,
    "note": "发送真实消息，请确认青文是测试联系人。"
  }
}
