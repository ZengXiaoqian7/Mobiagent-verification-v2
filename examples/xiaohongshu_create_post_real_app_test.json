{
  "schema_version": "app-test-case-v1",
  "test_case_id": "xiaohongshu-create-text-note-real-001",
  "app_under_test": {
    "name": "Xiaohongshu",
    "package": "com.xingin.xhs_hos",
    "version": "9.38.3"
  },
  "feature": "create_text_note_with_generated_image",
  "preconditions": [
    {
      "condition_id": "logged_in",
      "type": "TEXT_ABSENT",
      "value_candidates": ["请先登录", "登录后查看", "Log in"],
      "failure_class": "ENV_BLOCKED",
      "description": "The test account is already logged in"
    },
    {
      "condition_id": "network_available",
      "type": "TEXT_ABSENT",
      "value_candidates": ["网络异常", "无网络", "未连接", "重试"],
      "failure_class": "ENV_BLOCKED",
      "description": "The app can reach Xiaohongshu services"
    }
  ],
  "test_data": {
    "post_content": "app_test_${run_id}"
  },
  "observation_policy": {
    "immediate": true,
    "delays_ms": [500, 1500, 3000],
    "max_wait_ms": 5000,
    "stop_when_stable": true
  },
  "steps": [
    {
      "step_id": "open_xiaohongshu",
      "instruction": "Open Xiaohongshu by package",
      "action_type": "OPEN_APP",
      "target": {},
      "timeout_seconds": 10,
      "max_retries": 0
    },
    {
      "step_id": "open_publish_entry",
      "instruction": "点击底部导航中间的发布加号，打开发布方式选择面板",
      "action_type": "CLICK",
      "target": {
        "role": "button",
        "label": "底部发布加号",
        "text_candidates": ["+"]
      },
      "timeout_seconds": 10,
      "max_retries": 1
    },
    {
      "step_id": "select_write_text_entry",
      "instruction": "在发布方式面板中点击“写文字”，进入文字笔记编辑器",
      "action_type": "CLICK",
      "target": {
        "role": "button",
        "label": "写文字",
        "text_candidates": ["写文字"]
      },
      "timeout_seconds": 10,
      "max_retries": 1
    },
    {
      "step_id": "input_post_content",
      "instruction": "在文字笔记编辑器的正文输入区域输入本轮唯一测试内容",
      "action_type": "INPUT",
      "target": {
        "label": "说说你的想法吧",
        "role": "text_input",
        "text_candidates": ["说说你的想法吧"]
      },
      "value_ref": "post_content",
      "timeout_seconds": 10,
      "max_retries": 1
    },
    {
      "step_id": "open_image_generation",
      "instruction": "点击文字编辑器右上角的“生成”，进入“一句话生成配图”流程；不要把这个按钮理解为普通的卡片模板选择",
      "action_type": "CLICK",
      "target": {
        "label": "右上角生成",
        "text_candidates": ["生成"]
      },
      "timeout_seconds": 20,
      "max_retries": 1
    },
    {
      "step_id": "wait_for_generated_images",
      "instruction": "等待配图生成完成，直到页面出现“选择配图”和生成出的配图缩略图；等待期间不要点击“取消”或其他按钮",
      "action_type": "WAIT",
      "target": {
        "surface_text_candidates": ["选择配图", "确定"]
      },
      "timeout_seconds": 40,
      "max_retries": 0
    },
    {
      "step_id": "select_generated_image",
      "instruction": "在“选择配图”页面点击第一张已经生成的配图缩略图；不要点击“换搭配”或“确定”",
      "action_type": "CLICK",
      "target": {
        "role": "image",
        "label": "第一张已生成的配图缩略图"
      },
      "timeout_seconds": 20,
      "max_retries": 1
    },
    {
      "step_id": "confirm_generated_image",
      "instruction": "点击“确定”确认当前选择的配图，进入发布编辑页面",
      "action_type": "CLICK",
      "target": {
        "role": "button",
        "text_candidates": ["确定"]
      },
      "timeout_seconds": 20,
      "max_retries": 1
    },
    {
      "step_id": "publish_note",
      "instruction": "在发布编辑页面点击“发布”提交这条测试笔记",
      "action_type": "CLICK",
      "target": {
        "role": "button",
        "text_candidates": ["发布笔记", "发布"]
      },
      "timeout_seconds": 30,
      "max_retries": 1
    }
  ],
  "expected_results": [
    {
      "assertion_id": "post_content_visible_in_own_note_list",
      "type": "TEXT_VISIBLE",
      "expected_value_ref": "post_content",
      "surface": "own_note_list",
      "after_step": "publish_note",
      "historical_match_not_sufficient": true,
      "requires_verification_runner": true,
      "required": true
    }
  ],
  "verification_steps": [
    {
      "verification_step_id": "wait_after_publish",
      "instruction": "Wait briefly for the publish result page or feed transition to settle",
      "action_type": "WAIT",
      "timeout_seconds": 5,
      "max_retries": 0
    },
    {
      "verification_step_id": "navigate_to_me_tab",
      "instruction": "Navigate to the Me tab or own profile page",
      "action_type": "NAVIGATE",
      "target": {
        "label": "我",
        "text_candidates": ["我"],
        "surface_text_candidates": ["笔记", "收藏", "赞过"]
      },
      "timeout_seconds": 10,
      "max_retries": 1
    },
    {
      "verification_step_id": "navigate_to_own_note_list",
      "instruction": "Navigate to the own note list if it is not already selected",
      "action_type": "NAVIGATE",
      "target": {
        "role": "button",
        "text_candidates": ["笔记", "作品", "帖子"],
        "surface_text_candidates": ["笔记", "作品", "帖子"]
      },
      "timeout_seconds": 10,
      "max_retries": 1
    },
    {
      "verification_step_id": "wait_for_note_list_load",
      "instruction": "Wait for the own note list to finish loading",
      "action_type": "WAIT",
      "timeout_seconds": 5,
      "max_retries": 0
    },
    {
      "verification_step_id": "refresh_own_note_list",
      "instruction": "Refresh the own note list once",
      "action_type": "REFRESH",
      "target": {
        "surface_text_candidates": ["笔记", "作品", "帖子"]
      },
      "timeout_seconds": 5,
      "max_retries": 0
    },
    {
      "verification_step_id": "scroll_own_note_list",
      "instruction": "Scroll the own note list a limited amount while looking for this run's unique content",
      "action_type": "SCROLL",
      "target": {
        "direction": "up",
        "surface_text_candidates": ["笔记", "作品", "帖子"]
      },
      "timeout_seconds": 5,
      "max_retries": 0
    },
    {
      "verification_step_id": "observe_own_note_list",
      "instruction": "Observe the own note list for this run's unique content",
      "action_type": "OBSERVE",
      "target": {
        "surface": "own_note_list",
        "surface_text_candidates": ["笔记", "作品", "帖子"]
      },
      "timeout_seconds": 5,
      "max_retries": 0
    }
  ],
  "verification_policy": {
    "max_steps": 8,
    "timeout_seconds": 60,
    "max_retries": 2
  },
  "verification_runner_policy": "REQUIRED_FOR_RESULT",
  "risk_level": "MEDIUM",
  "metadata": {
    "stage": "stage6-real-commercial",
    "real_device_required": true,
    "test_account_required": true,
    "package_confirmed_by_hdc": "com.xingin.xhs_hos",
    "ability_confirmed_by_hdc": "EntryAbility",
    "manual_runtime_note": "已根据 2026-08-26 实机轨迹确认：文字编辑器的“生成”会进入“一句话生成配图”，随后异步出现“选择配图”页面；发布结果仍只在只读 Verification Runner 观察本人笔记列表后判定。"
  }
}
