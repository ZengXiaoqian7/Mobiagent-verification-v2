# Public source-release policy: keep local documentation and all test code in
# the working tree, but never include them in the publish branch.
docs/
tests/
**/docs/
**/tests/
**/test_*.py
**/*_test.py
**/*.md
**/*.rst
!/README.md

# Current architecture documents are release inputs and must stay reviewable.
!/PLAN.md
!/APP_TEST_AGENT_README.md
!/docs/
docs/*
!/docs/STAGE4_MOBIAGENT_PREFLIGHT.md

# MobiAgent runtime prompt assets are source inputs, not documentation.
!prompts/
prompts/*.md
!prompts/grounder_qwen3_bbox.md
!prompts/grounder_qwen3_coordinates.md
!prompts/grounder_bbox.md
!prompts/grounder_coordinates.md
!prompts/decider_v2.md
!prompts/planner_oneshot.md
!prompts/planner_oneshot_harmony.md

# The root regression suite is synthetic and safe to publish. Keep nested
# third-party/local test trees excluded by the broad rules above.
!/tests/
!/tests/**/*.py

