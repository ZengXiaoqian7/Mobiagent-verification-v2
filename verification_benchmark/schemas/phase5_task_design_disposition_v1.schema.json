{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobiagent.local/schemas/phase5_task_design_disposition_v1.schema.json",
  "title": "Phase 5 task-design disposition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "authority", "publication_eligible", "is_ground_truth", "is_verifier_output", "automated_verifier_run_before_disposition", "experiment_id", "experiment_manifest_sha256", "run_id", "task_id", "intake_receipt_file_sha256", "intake_receipt_semantic_sha256", "source_tree_sha256", "operator_feedback_file_sha256_at_review", "runner_capability_observation", "performance_cohort_eligible", "retirement_reason", "source_evidence_frame", "target_evidence_frame", "observed_source_slot", "observed_target_query", "observed_action_chain", "design_findings", "replacement_policy"],
  "properties": {
    "schema_version": {"const": "harmony-eval-phase5-task-design-disposition-v1"},
    "status": {"const": "RETIRED_FROM_PERFORMANCE_COHORT_CONSTRUCT_INVALID"},
    "authority": {"const": "PHASE5_EXPERIMENT_DESIGN_REVIEW"},
    "publication_eligible": {"const": false},
    "is_ground_truth": {"const": false},
    "is_verifier_output": {"const": false},
    "automated_verifier_run_before_disposition": {"const": false},
    "experiment_id": {"const": "phase5-cross-app-challenge-smoke-v2"},
    "experiment_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"const": "p5r-2026071700000002"},
    "task_id": {"const": "crossapp-commuter-bag-001"},
    "intake_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
    "intake_receipt_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "operator_feedback_file_sha256_at_review": {"$ref": "#/$defs/sha256"},
    "runner_capability_observation": {"const": "CROSS_APP_ACTION_CHAIN_OBSERVED_COMPLETE"},
    "performance_cohort_eligible": {"const": false},
    "retirement_reason": {"const": "LOW_REALISM_SINGLE_ABSTRACT_STYLE_SLOT_TRANSFER"},
    "source_evidence_frame": {"const": 5},
    "target_evidence_frame": {"const": 8},
    "observed_source_slot": {"const": "轻便通勤"},
    "observed_target_query": {"const": "轻便通勤"},
    "observed_action_chain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "design_findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "replacement_policy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
