{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobiagent.local/schemas/phase5_single_operator_ground_truth_v1.schema.json",
  "title": "Phase 5 single-operator experimental Ground Truth v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "ground_truth_status", "publication_eligible", "eligible_for_development_performance_evaluation", "formal_double_blind_review_completed", "claim_boundary", "experiment_id", "experiment_manifest_sha256", "run_id", "task_id", "intake_receipt_file_sha256", "intake_receipt_semantic_sha256", "source_tree_sha256", "review_rubric_sha256", "operator_alias_sha256", "observation_mode", "observed_live", "automated_verifier_run_before_review", "runner_self_report_used_as_authority", "verdict", "failure_codes", "evidence_frames", "notes", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "harmony-eval-phase5-single-operator-ground-truth-v1"},
    "authority": {"const": "PHASE5_SINGLE_OPERATOR_LIVE_OBSERVATION"},
    "ground_truth_status": {"const": "FROZEN_SINGLE_OPERATOR_EXPERIMENT_GROUND_TRUTH"},
    "publication_eligible": {"const": false},
    "eligible_for_development_performance_evaluation": {"const": true},
    "formal_double_blind_review_completed": {"const": false},
    "claim_boundary": {"const": "S0_S1_BLACK_BOX_ONLY_NO_BACKEND_SIDE_EFFECT_CLAIM"},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "pattern": "^p5r-[0-9a-f]{16}$"},
    "task_id": {"type": "string", "minLength": 1},
    "intake_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
    "intake_receipt_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "review_rubric_sha256": {"$ref": "#/$defs/sha256"},
    "operator_alias_sha256": {"$ref": "#/$defs/sha256"},
    "observation_mode": {"const": "LIVE_DEVICE_PLUS_HASH_BOUND_RECEIPT"},
    "observed_live": {"const": true},
    "automated_verifier_run_before_review": {"const": false},
    "runner_self_report_used_as_authority": {"const": false},
    "verdict": {"enum": ["PASS", "FAIL", "AMBIGUOUS"]},
    "failure_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["NONE", "WRONG_APP", "WRONG_QUERY", "SOURCE_RECOMMENDATION_NOT_OBSERVED", "CROSS_APP_TRANSFER_INCORRECT", "TARGET_RESULTS_NOT_LOADED", "IRRELEVANT_RESULTS", "FORBIDDEN_ACTION_OR_SURFACE", "PREMATURE_DONE", "TASK_INCOMPLETE", "EVIDENCE_AMBIGUOUS", "OTHER"]}
    },
    "evidence_frames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "notes": {"type": "string"},
    "created_at_utc": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
