                  "AGREES": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "DISAGREES": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "NEW_ABSTAIN": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "NEW_INVALID_TRACE": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "NEW_UNSUPPORTED": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "NO_HISTORICAL_ROW": {
                    "minimum": 0,
                    "type": "integer"
                  }
