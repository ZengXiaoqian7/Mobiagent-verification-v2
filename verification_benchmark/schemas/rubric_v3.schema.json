{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric_v3.schema.json",
  "title": "VerificationRubric V3",
  "type": "object",
  "required": ["schema_version", "rubric_id", "version", "task_family", "source", "criteria", "metadata"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "rubric_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "task_family": {"type": "string", "minLength": 1},
    "source": {"enum": ["manual", "compiled", "migrated"]},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "dimension", "description", "requirement", "weight", "depends_on", "checker", "evidence_policy"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "dimension": {"enum": ["process", "outcome", "negative"]},
          "description": {"type": "string", "minLength": 1},
          "requirement": {"enum": ["required", "optional", "conditional", "negative"]},
          "weight": {"type": "number", "minimum": 0},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "checker": {"type": "object"},
          "evidence_policy": {"type": "object"},
          "failure_code": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
