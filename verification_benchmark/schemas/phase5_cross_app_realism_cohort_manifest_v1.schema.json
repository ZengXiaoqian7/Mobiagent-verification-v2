{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobiagent.local/schemas/phase5_cross_app_realism_cohort_manifest_v1.schema.json",
  "title": "Phase 5 final cross-App realism cohort manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "protocol_status", "publication_eligible", "claim_boundary", "oracle_database_dependency", "phase4_status", "pilot_ground_truth", "cohort", "package_probe", "agent", "collection_policy", "tasks"],
  "properties": {
    "schema_version": {"const": "harmony-eval-phase5-cross-app-realism-cohort-manifest-v1"},
    "experiment_id": {"const": "phase5-cross-app-realism-cohort-v1"},
    "protocol_status": {"const": "FINAL_CROSS_APP_REALISM_COHORT_FROZEN_BEFORE_COLLECTION"},
    "publication_eligible": {"const": false},
    "claim_boundary": {"const": "S0_S1_BLACK_BOX_ONLY_NO_BACKEND_SIDE_EFFECT_CLAIM"},
    "oracle_database_dependency": {"const": false},
    "phase4_status": {"const": "FROZEN_MECHANISM_VALIDATION_ONLY"},
    "pilot_ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "verdict", "file_sha256", "semantic_sha256", "used_for_design"],
      "properties": {
        "run_id": {"const": "p5r-2026071700000003"},
        "verdict": {"const": "FAIL"},
        "file_sha256": {"const": "8529796ccfde1f62822680aaaf230877e8501d7a9087764dae89674f0e903341"},
        "semantic_sha256": {"const": "41b04d1421402850d4f5033fe2a8f5d23ebddc07ea3f3fa65197c5c0e3c60961"},
        "used_for_design": {"const": true}
      }
    },
    "cohort": {"type": "object"},
    "package_probe": {"type": "object"},
    "agent": {"type": "object"},
    "collection_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["collection_order", "ground_truth_status", "guardrail_callbacks_allowed", "overwrite_allowed", "verifier_allowed_before_gt", "performance_cohort_status"],
      "properties": {
        "collection_order": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/taskId"}},
        "ground_truth_status": {"const": "PENDING_SINGLE_OPERATOR_REVIEW"},
        "guardrail_callbacks_allowed": {"const": false},
        "overwrite_allowed": {"const": false},
        "verifier_allowed_before_gt": {"const": false},
        "performance_cohort_status": {"const": "FROZEN_FOR_SINGLE_OPERATOR_GT"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "collection_ordinal", "task_family", "flow_type", "initial_app", "initial_package", "target_app", "target_package", "source_query", "selection_policy", "transfer_policy", "task_text", "expected_observable_criteria", "allowed_actions", "forbidden_actions", "difficulty_tags"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"},
        "collection_ordinal": {"type": "integer", "minimum": 1, "maximum": 12},
        "task_family": {"const": "cross_app_realism_final_read_only"},
        "flow_type": {"enum": ["taobao_to_xhs", "xhs_to_taobao"]},
        "initial_app": {"enum": ["淘宝", "小红书"]},
        "initial_package": {"enum": ["com.taobao.taobao4hmos", "com.xingin.xhs_hos"]},
        "target_app": {"enum": ["淘宝", "小红书"]},
        "target_package": {"enum": ["com.taobao.taobao4hmos", "com.xingin.xhs_hos"]},
        "source_query": {"$ref": "#/$defs/nonEmptyString"},
        "selection_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_surface", "rule", "excluded_visible_markers", "global_claim_allowed"],
          "properties": {
            "source_surface": {"$ref": "#/$defs/nonEmptyString"},
            "rule": {"$ref": "#/$defs/nonEmptyString"},
            "excluded_visible_markers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
            "global_claim_allowed": {"const": false}
          }
        },
        "transfer_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_slots", "maximum_slots", "slot_description", "exact_visible_support_required", "generic_only_forbidden"],
          "properties": {
            "minimum_slots": {"type": "integer", "minimum": 1, "maximum": 2},
            "maximum_slots": {"type": "integer", "minimum": 1, "maximum": 2},
            "slot_description": {"$ref": "#/$defs/nonEmptyString"},
            "exact_visible_support_required": {"const": true},
            "generic_only_forbidden": {"const": true}
          }
        },
        "task_text": {"$ref": "#/$defs/nonEmptyString"},
        "expected_observable_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "allowed_actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "forbidden_actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "difficulty_tags": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    }
  }
}
