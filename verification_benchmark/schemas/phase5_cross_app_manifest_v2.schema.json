{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobiagent.local/schemas/phase5_cross_app_manifest_v2.schema.json",
  "title": "Phase 5 Harmony cross-App challenge manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "protocol_status", "publication_eligible", "claim_boundary", "oracle_database_dependency", "phase4_status", "cohort", "package_probe", "agent", "collection_policy", "tasks"],
  "properties": {
    "schema_version": {"const": "harmony-eval-phase5-cross-app-manifest-v2"},
    "experiment_id": {"const": "phase5-cross-app-challenge-smoke-v2"},
    "protocol_status": {"const": "DEVELOPMENT_CROSS_APP_SMOKE_FROZEN_BEFORE_COLLECTION"},
    "publication_eligible": {"const": false},
    "claim_boundary": {"const": "S0_S1_BLACK_BOX_ONLY_NO_BACKEND_SIDE_EFFECT_CLAIM"},
    "oracle_database_dependency": {"const": false},
    "phase4_status": {"const": "FROZEN_MECHANISM_VALIDATION_ONLY"},
    "cohort": {
      "type": "object", "additionalProperties": false,
      "required": ["cohort_id", "device_serial", "device_model", "device_type", "posture", "resolution", "os_version"],
      "properties": {
        "cohort_id": {"type": "string", "minLength": 1},
        "device_serial": {"const": "5ZU0226122004500"},
        "device_model": {"const": "DEL-AL10"},
        "device_type": {"const": "Harmony"},
        "posture": {"const": "FOLDED_OUTER_DISPLAY"},
        "resolution": {"const": [1080, 2444]},
        "os_version": {"const": "OpenHarmony-6.1.1.120"}
      }
    },
    "package_probe": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "mode", "report_file_sha256", "report_semantic_sha256", "prior_same_path_attempt_preserved", "provenance_caveat", "installed_apps"],
      "properties": {
        "schema_version": {"const": "harmony-package-probe-v1"},
        "status": {"const": "PASS"},
        "mode": {"const": "READ_ONLY_PACKAGE_VERSION_PROBE"},
        "report_file_sha256": {"$ref": "#/$defs/sha256"},
        "report_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "prior_same_path_attempt_preserved": {"const": false},
        "provenance_caveat": {"type": "string", "minLength": 1},
        "installed_apps": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            {"$ref": "#/$defs/xiaohongshu"},
            {"$ref": "#/$defs/taobao"}
          ],
          "items": false
        }
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_base_url", "model", "transport", "key_env", "device", "use_qwen3", "use_experience", "user_profile", "use_graphrag", "accept_planner_changes", "decider_protocol", "coord_mode", "e2e", "max_steps", "runner_module_sha256"],
      "properties": {
        "provider_base_url": {"const": "https://api.horizon1123.top/v1"},
        "model": {"const": "gpt-5.4-mini"},
        "transport": {"const": "raw_http"},
        "key_env": {"const": "MOBIAGENT_API_KEY"},
        "device": {"const": "Harmony"},
        "use_qwen3": {"const": "on"},
        "use_experience": {"const": "off"},
        "user_profile": {"const": "off"},
        "use_graphrag": {"const": "off"},
        "accept_planner_changes": {"const": "off"},
        "decider_protocol": {"const": "qwen_json"},
        "coord_mode": {"const": "resized_pixel"},
        "e2e": {"const": true},
        "max_steps": {"const": 15},
        "runner_module_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "collection_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_tier", "allowed_apps", "allowed_actions", "forbidden_actions", "abort_conditions", "collection_order", "ground_truth_status", "guardrail_callbacks_allowed", "overwrite_allowed", "final_performance_cohort_status"],
      "properties": {
        "risk_tier": {"const": "LOW_RISK_CROSS_APP_READ_ONLY_RESEARCH_AND_SEARCH"},
        "allowed_apps": {"const": ["小红书", "淘宝"]},
        "allowed_actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "abort_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "collection_order": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"}
        },
        "ground_truth_status": {"const": "PENDING_SINGLE_OPERATOR_REVIEW"},
        "guardrail_callbacks_allowed": {"const": false},
        "overwrite_allowed": {"const": false},
        "final_performance_cohort_status": {"const": "NOT_FROZEN_UNTIL_ALL_THREE_SMOKES_ARE_REVIEWED"}
      }
    },
    "tasks": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "installedAppBase": {
      "type": "object", "additionalProperties": false,
      "required": ["app", "package", "version_name", "version_code", "raw_dump_sha256"],
      "properties": {
        "app": {"type": "string"}, "package": {"type": "string"},
        "version_name": {"type": "string", "minLength": 1},
        "version_code": {"type": "integer", "minimum": 1},
        "raw_dump_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "xiaohongshu": {
      "allOf": [
        {"$ref": "#/$defs/installedAppBase"},
        {"type": "object", "properties": {"app": {"const": "小红书"}, "package": {"const": "com.xingin.xhs_hos"}, "version_name": {"const": "9.38.0"}, "version_code": {"const": 9380801}}}
      ]
    },
    "taobao": {
      "allOf": [
        {"$ref": "#/$defs/installedAppBase"},
        {"type": "object", "properties": {"app": {"const": "淘宝"}, "package": {"const": "com.taobao.taobao4hmos"}, "version_name": {"const": "10.64.0"}, "version_code": {"const": 770}}}
      ]
    },
    "slotPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_slots", "maximum_slots", "slot_description", "same_frame_required", "safety_constraint"],
      "properties": {
        "minimum_slots": {"type": "integer", "minimum": 1, "maximum": 2},
        "maximum_slots": {"type": "integer", "minimum": 1, "maximum": 2},
        "slot_description": {"type": "string", "minLength": 1},
        "same_frame_required": {"const": true},
        "safety_constraint": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "collection_ordinal", "task_family", "initial_app", "initial_package", "source_query", "target_app", "target_package", "dynamic_slot_policy", "task_text", "expected_observable_criteria", "allowed_actions", "forbidden_actions", "contract_source_route", "smoke_priority"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"},
        "collection_ordinal": {"type": "integer", "minimum": 1, "maximum": 3},
        "task_family": {"const": "cross_app_dynamic_transfer_read_only"},
        "initial_app": {"const": "小红书"},
        "initial_package": {"const": "com.xingin.xhs_hos"},
        "source_query": {"type": "string", "minLength": 1},
        "target_app": {"const": "淘宝"},
        "target_package": {"const": "com.taobao.taobao4hmos"},
        "dynamic_slot_policy": {"$ref": "#/$defs/slotPolicy"},
        "task_text": {"type": "string", "minLength": 1},
        "expected_observable_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "allowed_actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "contract_source_route": {"const": "template"},
        "smoke_priority": {"enum": ["FIRST", "SECOND", "THIRD"]}
      }
    }
  }
}
