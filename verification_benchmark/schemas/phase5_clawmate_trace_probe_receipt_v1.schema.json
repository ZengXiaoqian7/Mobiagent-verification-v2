{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobiagent.local/schemas/phase5_clawmate_trace_probe_receipt_v1.schema.json",
  "title": "Phase 5 ClawMate trace-capability probe receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_version", "intake_source_sha256", "status", "publication_eligible", "probe_id", "runner_profile", "run_id", "task_id", "probe_manifest_sha256", "collection_status", "ground_truth_status", "claim_boundary", "source_files", "source_tree_sha256", "capability_profile", "verifier_allowed_before_gt", "canonical_adapter_ready", "diagnostic_boundary", "errors"],
  "properties": {
    "schema_version": {"const": "harmony-eval-phase5-clawmate-trace-probe-receipt-v1"},
    "intake_version": {"const": "harmony-eval-phase5-clawmate-trace-probe-intake-v1"},
    "intake_source_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["ACCEPTED_FOR_TRACE_CAPABILITY_REVIEW", "REJECTED_COLLECTION_INCOMPLETE"]},
    "publication_eligible": {"const": false},
    "probe_id": {"const": "phase5-clawmate-trace-probe-v1"},
    "runner_profile": {"const": "CLAWMATE_CANDIDATE"},
    "run_id": {"type": "string", "pattern": "^p5r-[0-9a-f]{16}$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"},
    "probe_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "collection_status": {"enum": ["RUN_COMPLETE", "RUN_FAILED", "RUN_ABORTED", "RUN_IN_PROGRESS"]},
    "ground_truth_status": {"const": "PENDING_SINGLE_OPERATOR_REVIEW"},
    "claim_boundary": {"const": "S0_S1_BLACK_BOX_ONLY_NO_BACKEND_SIDE_EFFECT_CLAIM"},
    "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceFile"}},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "capability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_files", "action_count", "action_types", "screenshot_files", "hierarchy_files", "log_files", "has_actions", "has_screenshots", "has_ui_hierarchy", "has_logs", "canonical_adapter_ready"],
      "properties": {
        "action_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "action_count": {"type": "integer", "minimum": 0},
        "action_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "screenshot_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "hierarchy_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "log_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "has_actions": {"type": "boolean"},
        "has_screenshots": {"type": "boolean"},
        "has_ui_hierarchy": {"type": "boolean"},
        "has_logs": {"type": "boolean"},
        "canonical_adapter_ready": {"type": "boolean"}
      }
    },
    "verifier_allowed_before_gt": {"const": false},
    "canonical_adapter_ready": {"type": "boolean"},
    "diagnostic_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasoning_copied_to_receipt", "runner_self_report_copied_to_receipt", "logs_used_as_success_authority"],
      "properties": {
        "reasoning_copied_to_receipt": {"const": false},
        "runner_self_report_copied_to_receipt": {"const": false},
        "logs_used_as_success_authority": {"const": false}
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_ref", "byte_size", "sha256"],
      "properties": {
        "relative_ref": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
