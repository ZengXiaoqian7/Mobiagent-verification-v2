{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobiagent.local/schemas/simple_verifier_result_v1.schema.json",
  "title": "MobiFlow-compatible upgraded verifier result v1",
  "type": "object",
  "required": [
    "ok",
    "verdict",
    "reason",
    "failed_criteria",
    "evidence_frames",
    "needs_review"
  ],
  "properties": {
    "ok": {"type": "boolean"},
    "verdict": {
      "enum": ["PASS", "FAIL", "ABSTAIN", "INVALID_TRACE", "UNSUPPORTED"]
    },
    "reason": {"type": "string", "minLength": 1},
    "failed_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence_frames": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "uniqueItems": true
    },
    "needs_review": {"type": "boolean"},
    "mobiflow_baseline": {
      "type": "object",
      "required": ["ok", "verdict", "reason"],
      "properties": {
        "ok": {"type": "boolean"},
        "verdict": {
          "enum": ["PASS", "FAIL", "ABSTAIN", "INVALID_TRACE", "UNSUPPORTED"]
        },
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "then": {
        "properties": {
          "ok": {"const": true},
          "failed_criteria": {"maxItems": 0},
          "needs_review": {"const": false}
        }
      },
      "else": {"properties": {"ok": {"const": false}}}
    }
  ],
  "additionalProperties": false
}
